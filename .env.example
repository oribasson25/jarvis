# ב-Vercel מגדירים את אלה ב-Settings ← Environment Variables. הקובץ הזה רק לפיתוח מקומי.

# סיסמה לדשבורד. חובה ב-Vercel
DASHBOARD_PASSWORD=
# מחרוזת אקראית ארוכה, מגינה על api/worker. חובה ב-Vercel
CRON_SECRET=

# Upstash Redis. ב-Vercel נוצרים לבד כשמחברים את Upstash מ-Storage.
# מקומית: בלעדיהם הכל נשמר בזיכרון בלבד (או: vercel env pull .env)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# אופציונלי: אפשר להגדיר אותו גם בדשבורד, ושם הוא גובר על מה שכתוב כאן
ANTHROPIC_API_KEY=

# פיתוח מקומי בלבד
PORT=3300
HOST=127.0.0.1
LOG_LEVEL=info
