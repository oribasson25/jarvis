# מפתח ל-Claude API (https://platform.claude.com/settings/keys)
# אופציונלי: אפשר להגדיר אותו גם בדשבורד, ושם הוא גובר על מה שכתוב כאן
ANTHROPIC_API_KEY=

# הדשבורד: http://localhost:3300
PORT=3300
# 127.0.0.1 = נגיש רק מהמחשב הזה. אם מריצים על שרת ומשנים ל-0.0.0.0 - חובה להגדיר סיסמה
HOST=127.0.0.1
DASHBOARD_PASSWORD=

LOG_LEVEL=info
